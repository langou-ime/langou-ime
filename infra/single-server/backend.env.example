LANGOU_ENVIRONMENT=production
LANGOU_POSTGRES_PASSWORD=replace-with-generated-hex-secret
LANGOU_REDIS_PASSWORD=replace-with-generated-hex-secret
LANGOU_DATABASE_URL=postgresql+asyncpg://langou:replace-with-url-encoded-secret@postgres:5432/langou
LANGOU_REDIS_URL=redis://:replace-with-url-encoded-secret@redis:6379/0
LANGOU_JWT_SECRET=replace-with-at-least-32-random-characters
LANGOU_SMS_PEPPER=replace-with-at-least-32-random-characters
LANGOU_HISTORY_KEY=replace-with-urlsafe-base64-32-byte-key
LANGOU_PHONE_KEY=replace-with-urlsafe-base64-32-byte-key
LANGOU_MIMO_API_BASE=https://token-plan-cn.xiaomimimo.com/v1
LANGOU_MIMO_API_KEY=replace-with-runtime-secret
LANGOU_MIMO_PRIMARY_MODEL=mimo-v2.5-pro
LANGOU_MIMO_FALLBACK_MODEL=mimo-v2.5
LANGOU_AI_PER_MINUTE_LIMIT=20
LANGOU_AI_DAILY_BUDGET=100000
LANGOU_ALIYUN_ACCESS_KEY_ID=replace-with-runtime-secret
LANGOU_ALIYUN_ACCESS_KEY_SECRET=replace-with-runtime-secret
LANGOU_ALIYUN_SMS_SIGN_NAME=replace-with-approved-sign-name
LANGOU_ALIYUN_SMS_TEMPLATE_CODE=replace-with-approved-template-code
LANGOU_CORS_ORIGINS=["https://langou.tech","https://www.langou.tech"]
LANGOU_RELEASE_MANIFEST_DIR=/srv/releases
