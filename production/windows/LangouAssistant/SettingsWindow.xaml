<Window x:Class="LangouAssistant.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="懒狗输入法 · 账号与设置"
        Width="520"
        Height="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource CreamBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
        <Border Width="82" Height="82" CornerRadius="24" Background="#FFFFE3EC">
          <Image Source="/LangouAssistant;component/Assets/Mascot.png"
                 Stretch="Uniform"
                 Margin="4" />
        </Border>
        <StackPanel Margin="16,10,0,0">
          <TextBlock Text="懒狗输入法"
                     FontSize="25"
                     FontWeight="Bold"
                     Foreground="{StaticResource InkBrush}" />
          <TextBlock Text="普通输入离线可用 · AI 只写入不发送"
                     Margin="0,7,0,0"
                     Foreground="{StaticResource MutedInkBrush}" />
        </StackPanel>
      </StackPanel>

      <Border Background="White" CornerRadius="22" Padding="20" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="手机号登录与同步"
                     FontWeight="SemiBold"
                     FontSize="16"
                     Foreground="{StaticResource InkBrush}" />
          <TextBlock x:Name="AccountStatus"
                     Text="游客也能正常输入和使用 AI"
                     Margin="0,5,0,12"
                     FontSize="12"
                     Foreground="{StaticResource MutedInkBrush}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PhoneBox"
                     Height="38"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     BorderBrush="#44E97E9F"
                     Text="+86 " />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Content="发送验证码"
                    Click="SendSms_Click"
                    Background="{StaticResource LavenderBrush}"
                    BorderThickness="0"
                    Cursor="Hand" />
          </Grid>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CodeBox"
                     Height="38"
                     MaxLength="6"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     BorderBrush="#44E97E9F" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Content="登录并合并"
                    Click="VerifySms_Click"
                    Background="{StaticResource PeachBrush}"
                    BorderThickness="0"
                    Cursor="Hand" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Background="White" CornerRadius="22" Padding="20" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="键盘与 AI"
                     FontWeight="SemiBold"
                     FontSize="16"
                     Foreground="{StaticResource InkBrush}" />
          <Grid Margin="0,14,0,8">
            <TextBlock Text="皮肤" VerticalAlignment="Center" />
            <ComboBox x:Name="ThemeBox"
                      HorizontalAlignment="Right"
                      Width="160"
                      SelectedValuePath="Tag">
              <ComboBoxItem Content="奶油懒狗" Tag="cream" />
              <ComboBoxItem Content="樱桃汽水" Tag="soda" />
              <ComboBoxItem Content="月光软糖" Tag="moon" />
            </ComboBox>
          </Grid>
          <CheckBox x:Name="AutoSuggestBox"
                    Content="聊天上下文变化后自动生成三条建议"
                    Margin="0,8" />
          <CheckBox x:Name="SaveHistoryBox"
                    Content="保存并同步 AI 历史（默认 30 天）"
                    Margin="0,8" />
          <CheckBox x:Name="DiagnosticsBox"
                    Content="主动开启匿名诊断（不含聊天正文）"
                    Margin="0,8" />
          <Button Content="保存设置"
                  Margin="0,12,0,0"
                  Height="40"
                  Click="SaveSettings_Click"
                  Background="{StaticResource PeachBrush}"
                  BorderThickness="0"
                  Cursor="Hand" />
        </StackPanel>
      </Border>

      <Border Background="White" CornerRadius="22" Padding="20">
        <StackPanel>
          <TextBlock Text="隐私与更新"
                     FontWeight="SemiBold"
                     FontSize="16"
                     Foreground="{StaticResource InkBrush}" />
          <TextBlock Text="密码框、银行支付、密码管理器和系统安全页始终零采集。OCR 截图只存在于本机内存，识别后立即释放。"
                     TextWrapping="Wrap"
                     Margin="0,10,0,12"
                     Foreground="{StaticResource MutedInkBrush}"
                     LineHeight="20" />
          <WrapPanel>
            <Button Content="立即清空云历史"
                    Padding="12,8"
                    Margin="0,0,8,0"
                    Click="ClearHistory_Click"
                    Background="#FFFFEDF2"
                    BorderThickness="0"
                    Cursor="Hand" />
            <Button Content="检查安全更新"
                    Padding="12,8"
                    Click="CheckUpdate_Click"
                    Background="{StaticResource LavenderBrush}"
                    BorderThickness="0"
                    Cursor="Hand" />
            <Button Content="查看隐私政策"
                    Padding="12,8"
                    Margin="8,0,0,0"
                    Click="PrivacyPolicy_Click"
                    Background="#FFFFEDF2"
                    BorderThickness="0"
                    Cursor="Hand" />
          </WrapPanel>
          <TextBlock x:Name="ActionStatus"
                     Margin="0,10,0,0"
                     Foreground="{StaticResource MutedInkBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
