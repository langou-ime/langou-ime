LANGOU_ENVIRONMENT=production
LANGOU_DATABASE_URL=postgresql+asyncpg://langou:replace-with-postgres-password@postgres:5432/langou
LANGOU_REDIS_URL=redis://:replace-with-redis-password@redis:6379/0
LANGOU_JWT_SECRET=replace-with-48-byte-random-secret
LANGOU_SMS_PEPPER=replace-with-48-byte-random-pepper
LANGOU_HISTORY_KEY=replace-with-url-safe-base64-32-byte-key
LANGOU_PHONE_KEY=replace-with-url-safe-base64-32-byte-key
LANGOU_MIMO_API_BASE=https://token-plan-cn.xiaomimimo.com/v1
LANGOU_MIMO_API_KEY=replace-with-mimo-api-key
LANGOU_MIMO_PRIMARY_MODEL=mimo-v2.5-pro
LANGOU_MIMO_FALLBACK_MODEL=mimo-v2.5
LANGOU_AI_PER_MINUTE_LIMIT=20
LANGOU_AI_DAILY_BUDGET=100000
LANGOU_ALIYUN_ACCESS_KEY_ID=replace-with-ram-access-key-id
LANGOU_ALIYUN_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret
LANGOU_ALIYUN_SMS_SIGN_NAME=replace-with-approved-sign-name
LANGOU_ALIYUN_SMS_TEMPLATE_CODE=replace-with-approved-template-code
LANGOU_CORS_ORIGINS=["http://langou.tech","https://langou.tech"]
LANGOU_RELEASE_MANIFEST_DIR=/srv/releases
