<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LangouAssistant.Core\LangouAssistant.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LangouInstaller\Package.wxs"
          Link="Installer\Package.wxs"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\scripts\Build-LangouPackage.ps1"
          Link="Scripts\Build-LangouPackage.ps1"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\.github\workflows\langou-release.yml"
          Link="Workflows\langou-release.yml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\.github\workflows\langou-windows-ci.yml"
          Link="Workflows\langou-windows-ci.yml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\.signpath\artifact-configurations\langou-windows-msi.xml"
          Link="SignPath\langou-windows-msi.xml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\WeaselServer\WeaselServerApp.cpp"
          Link="Native\WeaselServerApp.cpp"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PRIVACY.md"
          Link="Public\PRIVACY.md"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\README.md"
          Link="Public\README.md"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CODE_SIGNING_POLICY.md"
          Link="Public\CODE_SIGNING_POLICY.md"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LangouInstaller\Assets\Privacy.rtf"
          Link="Installer\Privacy.rtf"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LangouAssistant\SettingsWindow.xaml"
          Link="Assistant\SettingsWindow.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LangouAssistant\SettingsWindow.xaml.cs"
          Link="Assistant\SettingsWindow.xaml.cs"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
